# Fig. 6 - class-associated residues on the GHSR structures
# generated by revision/make_fig6_pymol.py - distances match Table 1
reinitialize
bg_color white
set ray_opaque_background, 1
set orthoscopic, 1
set cartoon_fancy_helices, 1
set cartoon_transparency, 0.45
set stick_radius, 0.26
set sphere_scale, 0.30
set label_size, 16
set float_labels, 1
set label_connector, 1
set label_connector_color, grey50
set label_connector_width, 1.2
set label_connector_mode, 1
set label_color, black
set label_outline_color, white
set label_position, (0, 2.2, 0)
set dash_width, 2.2
set dash_gap, 0.35
set dash_color, grey40
set depth_cue, 0
set ray_shadows, 0
set antialias, 2

# ---------------- 8jsr: agonist-bound (anamorelin) ----------------
# expects 8jsr.pdb beside this script, otherwise use:
#   fetch 8JSR, 8jsr, async=0
load 8jsr.pdb, 8jsr
remove 8jsr and not (chain R or resn UYI)
# chain R of 6KO5 also carries a BRIL fusion (residues >1000)
remove 8jsr and polymer and chain R and resi 1000-2000
remove 8jsr and (solvent or hydro)
hide everything, 8jsr
show cartoon, 8jsr and chain R
color grey85, 8jsr and chain R
set cartoon_color, grey85, 8jsr
show sticks, 8jsr and resn UYI
color yellow, 8jsr and resn UYI and elem C

select 8jsr_hel_TM3, 8jsr and chain R and resi 130 and name CA
label 8jsr_hel_TM3, "TM3"
set label_color, grey30, 8jsr_hel_TM3
set label_size, 20, 8jsr_hel_TM3
set label_position, (48.33, -13.49, 0.00), 8jsr_hel_TM3
select 8jsr_hel_TM5, 8jsr and chain R and resi 210 and name CA
label 8jsr_hel_TM5, "TM5"
set label_color, grey30, 8jsr_hel_TM5
set label_size, 20, 8jsr_hel_TM5
set label_position, (54.64, 0.00, 0.00), 8jsr_hel_TM5
