set label_size, 20, 8jsr_hel_ICL2
set label_position, (43.02, 0.00, 0.00), 8jsr_hel_ICL2

select 8jsr_EC50_124, 8jsr and chain R and resi 124
show sticks, 8jsr_EC50_124 and sidechain
color firebrick, 8jsr_EC50_124 and elem C
show spheres, 8jsr_EC50_124 and name CA
color firebrick, 8jsr_EC50_124 and name CA
set label_position, (-31.34, -20.23, 0.00), 8jsr_EC50_124
label 8jsr_EC50_124 and name CA, "E124  3.4 A"
# E124: minimum heavy-atom distance 3.39 A
distance 8jsr_EC50_d124, 8jsr_EC50_124 and name OE1, 8jsr and resn UYI and name C10
